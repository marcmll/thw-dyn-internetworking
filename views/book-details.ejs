<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    <!-- Title -->
    <title>BetterReads &raquo; <%= book.title %></title>
    <base href="/">

    <!-- CSS -->
    <link rel="stylesheet" type="text/css" href="/css/global.css">
    <link rel="stylesheet" type="text/css" href="/css/book-details.css">
</head>
<body>
    <div class="background"></div>
    <header>
        <div class="container">
            <a href="/">
                <img src="media/assets/logo.svg" alt="BetterReads logo" draggable="false">
            </a>
            <nav>
                <!-- Search Form -->
                <form class="search" action="/dbSearch" method="POST">
                    <img class="search-icon" src="media/assets/search-icon.svg" alt="Search Icon">
                    <input type="text" placeholder="Search Books by Title or ISBN" name="searchQuery" autocomplete="off"/>
                    <button class="btn" id="nav-search" type="submit">Search</button>
                </form>
            </nav>
        </div>
    </header>
    <main>
        <div class="container">
            <div class="book-details">
                <div class="book-highlights">
                    <div class="book-cover">
                        <img src="<%= book.bookMediaLink %>" alt="<%= book.title %> Book Cover">
                    </div>
                    <div class="book-title">
                        <h1><%= book.title %></h1>
                        <p class="author">
                            <!-- For each of the authors in the array, display the authors seperated by a comma -->
                            <% for (let i = 1; i <= book.authors.length; i++) { %>
                                <%= book.authors[(i - 1)] %><% if(i !== (book.authors.length)) { %>,<% } %>
                            <% } %>
                        </p>
                    </div>
                    <div class="book-rating">
                        <div class="book-rating-stars">
                            <!-- Display the amount of stars equivilent to the numberRating value, rounded down -->
                            <% const averageRatingInteger = book.averageRating.toFixed(1) %>
                            <% for (let j = 1; j <= Math.floor(averageRatingInteger); j++) { %>
                                <img src="media/assets/rating-star.svg" alt="Star Icon">
                            <% } %>
                            <!-- Calculate if a half-star should be shown, if so: display a half-star icon -->
                            <% if ((Math.round(averageRatingInteger) - averageRatingInteger !== 0) && (Math.round(averageRatingInteger) - Math.round(averageRatingInteger).toFixed(0) !== 1)) { %>
                                <img src="media/assets/half-rating-star.svg" alt="Half Star Icon">
                                <!-- Fill in the missing stars with faded stars -->
                                <% for (let j = 4; j > Math.floor(averageRatingInteger); j--) { %>
                                    <img class="faded" src="media/assets/rating-star.svg" alt="Star Icon">
                                <% } %>
                            <% } else { %>
                                <!-- Fill in the missing stars with faded stars -->
                                <% for (let j = 5; j > Math.floor(averageRatingInteger); j--) { %>
                                    <img class="faded" src="media/assets/rating-star.svg" alt="Star Icon">
                                <% } %>
                            <% } %>
                        </div>
                        <p class="book-rating-info text-light">
                            (<%= book.averageRating.toFixed(2).toString().replace('.', ',') %> Avg Rating&nbsp;&nbsp;|&nbsp;&nbsp;<%= book.reviewCount %> Reviews)
                        </p>
                    </div>
                    <div class="book-share">
                        <a class="btn btn-light-blue" target="_blank" href="mailto:?subject=BetterReads:%20<%= book.title.split(' ').join('%20') %>&body=Check%20out%20%22<%= book.title.split(' ').join('%20') %>%22%20on%20BetterReads!%20http://betterreads.com/book/<%= book.bookId %>%0A%0A<%= book.description.split(' ').join('%20') %>">
                            <img src="media/assets/share-icon-blue.svg" alt="Share Icon">
                            Share Book
                        </a>
                    </div>
                    <div class="book-meta">
                        <div class="meta-item">
                            <img src="media/assets/tag-icon.svg" alt="Genre Icon">
                            <p>
                                <!-- For each of the genres in the array, display the gernes seperated by a comma -->
                                <% for (let i = 1; i <= book.genres.length; i++) { %>
                                    <%= book.genres[(i - 1)] %><% if(i !== (book.genres.length)) { %>,<% } %>
                                <% } %>
                            </p>
                        </div>
                        <div class="meta-item">
                            <img src="media/assets/pages-icon.svg" alt="Pages Icon">
                            <p><%= book.pageCount %> Pages</p>
                        </div>
                    </div>
                </div>
                <div class="book-description">
                    <p>
                        <%- book.description %>
                    </p>
                    <div class="book-meta hide-m">
                        <div class="meta-item">
                            <img src="media/assets/cal-icon.svg" alt="Calender Icon">
                            <p><%= book.datePublished %></p>
                        </div>
                        <div class="meta-item">
                            <img src="media/assets/language-icon.svg" alt="Language Icon">
                            <p><%= book.language %></p>
                        </div>
                        <div class="meta-item">
                            <img src="media/assets/isbn-icon.svg" alt="Hash Icon">
                            <p>ISBN: <%= book.isbn %></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="book-reviews">
                <div class="header">
                    <h2>Ratings & Reviews</h2>
                    <!-- <a class="btn btn-blue" href="#">
                        Review This Book
                    </a> -->
                </div>
                <% if (typeof userReview != 'undefined') { %>
                    <div class="review highlight">
                        <div class="header">
                            <div class="rating">
                                <p><b>You</b> rated it</p>
                                <div class="rating-stars">
                                    <!-- Display the amount of stars equivilent to the numberRating value -->
                                    <% for (let j = 1; j <= userReview.numberRating; j++) { %>
                                        <img src="media/assets/rating-star.svg" alt="Star Icon">
                                    <% } %>
                                    <!-- Fill in the missing stars with faded stars -->
                                    <% for (let j = 5; j > userReview.numberRating; j--) { %>
                                        <img class="faded" src="media/assets/rating-star.svg" alt="Faded Star Icon">
                                    <% } %>
                                </div>
                            </div>
                            <p class="date text-light">
                                <span class="hide-s"><%= userReview.dateLongFormat %></span>
                                <span class="hide-xxl show-s"><%= userReview.dateShortFormat %></span>
                            </p>
                        </div>
                        <div class="description">
                            <p><%= userReview.description %></p>
                        </div>
                    </div>
                <% } else { %>
                    <!-- Review Upload Form -->
                    <form action="/uploadReview" id="review-upload-form" method="POST">
                        <input name="bookId" type="hidden" value="<%= book.bookId %>">
                        <input name="bookObjectId" type="hidden" value="<%= book._id %>">
                        <div class="form-input">
                            <input type="text" name="userName" id="userName" autocomplete="off" required autocomplete="off">
                            <label for="userName">Name *</label>
                            <p></p>
                        </div>
                        <input type="hidden" min="1" max="5" name="numberRating" id="number-rating" required>
                        <!-- Number rating stars -->
                        <div class="number-rating">
                            <div class="star-icon" id="number-rating-5" onclick="updateRating(this.id)">
                                <img src="media/assets/rating-star.svg" alt="Star Icon">
                            </div><div class="star-icon" id="number-rating-4" onclick="updateRating(this.id)">
                                <img src="media/assets/rating-star.svg" alt="Star Icon">
                            </div><div class="star-icon" id="number-rating-3" onclick="updateRating(this.id)">
                                <img src="media/assets/rating-star.svg" alt="Star Icon">
                            </div><div class="star-icon" id="number-rating-2" onclick="updateRating(this.id)">
                                <img src="media/assets/rating-star.svg" alt="Star Icon">
                            </div><div class="star-icon" id="number-rating-1" onclick="updateRating(this.id)">
                                <img src="media/assets/rating-star.svg" alt="Star Icon">
                            </div>
                            <p></p>
                        </div>
                        <div class="form-input textarea">
                            <textarea name="description" id="description" required autocomplete="off"></textarea>
                            <label for="description">Review *</label>
                            <p></p>
                        </div>
                        <div class="privacy-policy">
                            <label for="acceptPrivacyPolicy">For information on how we use data see our <a href="#">privacy policy</a></label>
                        </div>
                        <button onclick="validateForm()" type="button">Submit</button>
                    </form>
                <% } %>
                <!-- For each of the reviews passed into the view engine, display a review div -->
                <% for (let i = 0; i < reviews.length; i++) { %>
                    <div class="review">
                        <div class="header">
                            <div class="rating">
                                <p><b><%= reviews[i].userName %></b> rated it</p>
                                <div class="rating-stars">
                                    <!-- Display the amount of stars equivilent to the numberRating value -->
                                    <% for (let j = 1; j <= reviews[i].numberRating; j++) { %>
                                        <img src="media/assets/rating-star.svg" alt="Star Icon">
                                    <% } %>
                                    <!-- Fill in the missing stars with faded stars -->
                                    <% for (let j = 5; j > reviews[i].numberRating; j--) { %>
                                        <img class="faded" src="media/assets/rating-star.svg" alt="Faded Star Icon">
                                    <% } %>
                                </div>
                            </div>
                            <p class="date text-light">
                                <span class="hide-s"><%= reviews[i].dateLongFormat %></span>
                                <span class="hide-xxl show-s"><%= reviews[i].dateShortFormat %></span>
                            </p>
                        </div>
                        <div class="description">
                            <p><%= reviews[i].description %></p>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
    <footer>
        <p>&copy; 2020 BetterReads&nbsp;&nbsp;|&nbsp;&nbsp;<a href="/terms">Terms</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="/privacy">Privacy Policy</a></p>
    </footer>

    <script type="text/javascript" src="/js/validateConditions.js"></script>
    <script type="text/javascript">
        // Set numberRating Value
        const updateRating = (ratingId) => {
            // Inject star rating value into the hidden number input with the id 'number-rating'
            document.querySelector('#number-rating').value = parseInt(ratingId.split('-')[2]);
            // Remove the class 'selected' from all divs within the '.number-rating' div
            document.querySelectorAll(`.number-rating > .star-icon`).forEach((item, index) => {
                document.getElementById(`number-rating-${index+1}`).classList.remove('selected');
            })
            // Add the class 'selected' to the star that was clicked by the user (highlights n amount of stars, where n is the rating clicked by the user)
            document.getElementById(ratingId).classList.add('selected');
        }

        // Form Validation Conditions
        const conditions = [
            {
                query: '#userName',
                min: 2,
                max: 16
            },
            {
                query: '#description',
                min: 2,
                max: 256
            }
        ];

        // Validation Function
        const validateForm = () => {
            const bookForm = document.querySelector('#review-upload-form');
            // Perform the validateConditions function for the defined conditions above
            let error = validateConditions(conditions);

            // Reset the error state in case the validation has been performed before
            document.querySelector('.number-rating').classList.remove('error');
            document.querySelector('.number-rating > p').classList.remove('errorMsg');
            document.querySelector('.number-rating > p').innerHTML = '';

            // validate if the number-rating was set
            if (document.querySelector('#number-rating').value == '') {
                document.querySelector('.number-rating').classList.add('error');
                document.querySelector('.number-rating > p').classList.add('errorMsg');
                document.querySelector('.number-rating > p').innerHTML = 'Please select a rating';
                error = true;
            }

            // If the error is false, submit the form
            if (!error) {
                bookForm.submit();
            }
        }
    </script>
</body>
</html>