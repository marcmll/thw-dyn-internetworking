<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    <!-- Title -->
    <title>BetterReads &raquo; Edit Book</title>
    <base href="/">

    <!-- CSS -->
    <link rel="stylesheet" type="text/css" href="/css/global.css">
    <link rel="stylesheet" type="text/css" href="/css/new-book-form.css">
</head>
<body>
    <div class="background"></div>
    <header>
        <div class="container">
            <a href="/backend">
                <img src="media/assets/logo.svg" alt="BetterReads logo" draggable="false">
            </a>
        </div>
    </header>
    <main>
        <div class="container">
            <h1><% if (book.length === 0) { %>Edit Book<% } else { %>Upload Book<% } %></h1>
            <form class="book-upload-form" id="book-upload-form" action="/uploadBook" method="POST" autocomplete="off">
                <!-- If there is an error returned form the database, display error messages here -->
                <% if (typeof errorData != 'undefined') { %>
                    <% errorData.forEach((item) => { %>
                        <p class="errorMsg"><%= item %></p>
                    <% }) %>
                <% } %>
                <!-- If book data is passed into the view engine, inputs are filled with the according data -->
                <div class="form-input col-6">
                    <input type="text" id="bookId" name="bookId" value="<% if (book.bookId !== undefined) { %><%= book.bookId %><% } %>" required autocomplete="off">
                    <label for="bookId">Book Id *</label>
                    <p></p>
                </div>
                <div class="form-input col-6">
                    <input type="text" id="title" name="title" value="<% if (book.title !== undefined) { %><%= book.title %><% } %>" required autocomplete="off">
                    <label for="title">Title *</label>
                    <p></p>
                </div>
                <div class="form-input col-6">
                    <input type="text" id="authors" name="authors" value="<% if (book.authors !== undefined) { %><% for (let i = 1; i <= book.authors.length; i++) { %><%= book.authors[(i - 1)] %><% if(i !== (book.authors.length)) { %>, <% } %><% } %><% } %>" required autocomplete="off">
                    <label for="authors">Author(s) *</label>
                    <p></p>
                </div>
                <div class="form-input col-6">
                    <input type="text" id="genres" name="genres" value="<% if (book.genres !== undefined) { %><% for (let i = 1; i <= book.genres.length; i++) { %><%= book.genres[(i - 1)] %><% if(i !== (book.genres.length)) { %>, <% } %><% } %><% } %>" required autocomplete="off">
                    <label for="genres">Genre(s) *</label>
                    <p></p>
                </div>
                <div class="form-input col-12">
                    <textarea id="description" name="description" required autocomplete="off"><% if (book.description !== undefined) { %><%= book.description %><% } %></textarea>
                    <label for="description">Description *</label>
                    <p></p>
                </div>
                <div class="form-input col-6">
                    <input type="text" id="language" name="language" value="<% if (book.language !== undefined) { %><%= book.language %><% } %>" required autocomplete="off">
                    <label for="language">Language *</label>
                    <p></p>
                </div>
                <div class="form-input col-6">
                    <input type="number" id="pageCount" name="pageCount" value="<% if (book.pageCount !== undefined) { %><%= book.pageCount %><% } %>" required autocomplete="off">
                    <label for="pageCount">Page Count *</label>
                    <p></p>
                </div>
                <div class="form-input col-6">
                    <input type="text" id="datePublished" name="datePublished" value="<% if (book.datePublished !== undefined) { %><%= book.datePublished %><% } %>" required autocomplete="off">
                    <label for="datePublished">Date Published *</label>
                    <p></p>
                </div>
                <div class="form-input col-6">
                    <input type="text" id="isbn" name="isbn" value="<% if (book.isbn !== undefined) { %><%= book.isbn %><% } %>" required autocomplete="off">
                    <label for="isbn">ISBN *</label>
                    <p></p>
                </div>
                <div class="form-input col-12">
                    <input type="text" id="bookMediaLink" name="bookMediaLink" value="<% if (book.bookMediaLink !== undefined) { %><%= book.bookMediaLink %><% } %>" required autocomplete="off">
                    <label for="bookMediaLink">Media Link * </label>
                    <p></p>
                </div>
                <div class="form-input col-12 right-align">
                    <!-- Button triggering the validateForm function when clicked (instead of directly submitting the form) -->
                    <button type="button" onclick="validateForm()" class="btn btn-highlight dark-highlight">Submit</button>
                </div>
            </form>
        </div>
    </main>
    <footer>
        <p>&copy; 2020 BetterReads&nbsp;&nbsp;|&nbsp;&nbsp;<a href="/terms">Terms</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="/privacy">Privacy Policy</a></p>
    </footer>

    <script type="text/javascript" src="/js/validateConditions.js"></script>
    <script type="text/javascript">
        // Form Validation Conditions
        const conditions = [
            {
                query: '#bookId',
                min: 2,
                max: 64
            },
            {
                query: '#title',
                min: 2,
                max: 128
            },
            {
                query: '#authors',
                min: 2,
                max: 128
            },
            {
                query: '#genres',
                min: 2,
                max: 64,
                regex: '^[a-zA-Z]*(, ?[a-zA-Z]*)?$', // Regex for only words made up of letters seperated by commas
                errorMsg: 'Please specify 2 genres at most, seperated by a comma'
            },
            {
                query: '#description',
                min: 16,
                max: 4256
            },
            {
                query: '#language',
                min: 2,
                max: 20,
                regex: '^(English|German)$', // Regex for only English or German
                errorMsg: 'Currently we only support English and German'
            },
            {
                query: '#pageCount',
                min: 1,
                max: 5,
                regex: '^[0-9]*$', // Regex for only numbers
                errorMsg: 'Please only enter numbers'
            },
            {
                query: '#datePublished',
                regex: '^(?:[1-9]|[012][0-9]|3[01])(?:th|rd|nd|st) (January|Febuary|March|April|May|June|July|August|September|October|November|December) (?:1[0-9][0-9][0-9]|20[01][0-9]|2020)$', // Regex for only dates in the format:1st January 2020
                errorMsg: 'Please follow the format: 01st January 2000'
            },
            {
                query: '#isbn',
                regex: '^[0-9]{9}([0-9]|X)$', // Regex for isbn numbers with 10 numbers, or 9 numbers + X
                errorMsg: 'Please enter a valid ISBN (10 Num or 9 Num + X)'
            },
            {
                query: '#bookMediaLink',
                max: 256,
                regex: '(?:(?:https?|ftp|file):\/\/|www\.|ftp\.)(?:\([-A-Z0-9+&@#\/%=~_|$?!:,.]*\)|[-A-Z0-9+&@#\/%=~_|$?!:,.])*(?:\([-A-Z0-9+&@#\/%=~_|$?!:,.]*\)|[A-Z0-9+&@#\/%=~_|$])', // Regex for URLs
                errorMsg: 'Please enter a valid URL'
            }
        ];

        // Validation Function
        const validateForm = () => {
            const bookForm = document.querySelector('#book-upload-form');
            let error = validateConditions(conditions);
            // If the returned error from the validateCondition function is false, submit the form
            if (!error) {
                bookForm.submit();
            }
        }
    </script>
</body>
</html>