<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    <!-- Title -->
    <title>BetterReads &raquo; Home</title>
    <base href="/">

    <!-- CSS -->
    <link rel="stylesheet" type="text/css" href="/css/global.css">
    <link rel="stylesheet" type="text/css" href="/css/index.css">
</head>
<body>
    <div class="background"></div>
    <header>
        <div class="container">
            <img src="media/assets/logo.svg" alt="BetterReads logo" draggable="false">
            <nav>
                <!-- Search Form -->
                <form class="search" action="/dbSearch" method="POST">
                    <img class="search-icon" src="media/assets/search-icon.svg" alt="Search Icon">
                    <input type="text" placeholder="Search Books by Title or ISBN" name="searchQuery" autocomplete="off"/>
                    <button class="btn" id="nav-search" type="submit">Search</button>
                </form>
            </nav>
        </div>
    </header>
    <main>
        <div class="container">
            <section class="editor-picks">
                <div class="description">
                    <h1>Editor Picks</h1>
                    <p>Top books recommended by our editors, updated daily with new releases, throwbacks to old classics and award winning novels.</p>
                </div>
                <div class="slider">
                    <!-- For each of the books in the editor picks, display the cover image and link to the book detail page -->
                    <% for (let i = 0; i < editorPicks.length; i++) { %>
                        <a href="/book/<%= editorPicks[i].bookId %>" draggable="false">
                            <img src="<%= editorPicks[i].bookMediaLink %>" alt="book cover" draggable="false">
                        </a>
                    <% } %>
                </div>
            </section>
            <section class="wide-row">
                <h2>Popular Books</h2>
                <div class="book-row">
                    <!-- For each of the books in the popular books, display the cover, title, authors and rating; linking to the book detail page -->
                    <% for (let i = 0; i < popularBooks.length; i++) { %>
                        <div class="row-item">
                            <a href="/book/<%= popularBooks[i].bookId %>" draggable="false">
                                <img src="<%= popularBooks[i].bookMediaLink %>" alt="book cover" draggable="false">
                            </a>
                            <div class="book-info">
                                <a href="/book/<%= popularBooks[i].bookId %>" draggable="false">
                                    <p><%= popularBooks[i].title %></p>
                                </a>
                                <p class="author">
                                    <!-- For each of the authors in the array, display the authors seperated by a comma -->
                                    <% for (let j = 1; j <= popularBooks[i].authors.length; j++) { %>
                                        <%= popularBooks[i].authors[(j - 1)] %><% if(j !== (popularBooks[i].authors.length)) { %>,<% } %>
                                    <% } %>
                                </p>
                                <div class="star-rating">
                                    <!-- Display the amount of stars equivilent to the numberRating value, rounded down -->
                                    <% const averageRatingInteger = popularBooks[i].averageRating.toFixed(1) %>
                                    <% for (let j = 1; j <= Math.floor(averageRatingInteger); j++) { %>
                                        <img src="media/assets/rating-star.svg" alt="Star Icon">
                                    <% } %>
                                    <!-- Calculate if a half-star should be shown, if so: display a half-star icon -->
                                    <% if ((Math.round(averageRatingInteger) - averageRatingInteger !== 0) && (Math.round(averageRatingInteger) - Math.round(averageRatingInteger).toFixed(0) !== 1)) { %>
                                        <img src="media/assets/half-rating-star.svg" alt="Half Star Icon">
                                        <!-- Fill in the missing stars with faded stars -->
                                        <% for (let j = 4; j > Math.floor(averageRatingInteger); j--) { %>
                                            <img class="faded" src="media/assets/rating-star.svg" alt="Star Icon">
                                        <% } %>
                                    <% } else { %>
                                        <!-- Fill in the missing stars with faded stars -->
                                        <% for (let j = 5; j > Math.floor(averageRatingInteger); j--) { %>
                                            <img class="faded" src="media/assets/rating-star.svg" alt="Star Icon">
                                        <% } %>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </section>
        </div>
        <div class="container dark-bg">
            <section class="dense-row">
                <h2>Recently Added</h2>
                <div class="book-row">
                    <!-- For each of the books in the recently added books, display the cover and link to the book detail page -->
                    <% for (let i = 0; i < recentlyAdded.length; i++) { %>
                        <a href="/book/<%= recentlyAdded[i].bookId %>" draggable="false">
                            <img src="<%= recentlyAdded[i].bookMediaLink %>" alt="book cover" draggable="false">
                        </a>
                    <% } %>
                </div>
            </section>
        </div>
    </main>
    <footer>
        <p>&copy; 2020 BetterReads&nbsp;&nbsp;|&nbsp;&nbsp;<a href="/backend">Backend</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="/terms">Terms</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="/privacy">Privacy Policy</a></p>
    </footer>
</body>
</html>