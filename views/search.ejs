<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    <!-- Title -->
    <title>BetterReads &raquo; <%= book.title %></title>
    <base href="/">

    <!-- CSS -->
    <link rel="stylesheet" type="text/css" href="/css/style.css">
</head>
<body>
    <div class="background"></div>
    <header>
        <div class="container">
            <img>
            <nav>
                <div class="search">
                    <img  class="search-icon" src="media/assets/search-icon.svg" alt="Search Icon">
                    <input type="text" placeholder="Search Books by Title, Author or ISBN"/>
                    <a class="btn" href="#" id="nav-search">Search</a>
                </div>
            </nav>
        </div>
    </header>
    <main>
        <div class="container">
            <h2>Search Results for "Factfulness"</h2>
            <div class="search-results">
                <div class="search-result">
                    <div class="search-image">
                        <img src="./media/assets/book-cover.jpg" alt="book cover">
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>